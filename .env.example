# Copy to .env for local development. Never commit .env.
NODE_ENV=development
PORT=3000
# Local Postgres or a Neon *development* branch. Never the production database.
DATABASE_URL=postgres://user:password@localhost:5432/ress_dev
DATABASE_SSL=false
# Leave blank locally to get a random admin token printed at startup.
ADMIN_TOKEN=
APP_URL=http://localhost:3000
# Blank locally: verification and reset links are printed to the console.
MAIL_API_KEY=
MAIL_FROM=
# Shown to customers who choose bank transfer. Leave blank to hide that option.
BANK_TRANSFER_DETAILS=
TRUST_PROXY=0